# Copy to .env for Docker Compose. Never commit the real .env file.
APP_VERSION=local
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
FOOD_DELIVER_DB_NAME=the_food_mas2
FOOD_DELIVER_DB_USER=foodapp
FOOD_DELIVER_DB_PASSWORD=replace-with-a-random-app-password
IMPORT_SQL_ON_START=true

ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
